    "quadratic_equations": "xi_i^2=A_i+sqrt(2)*B_i; eta_i^2=A_i-sqrt(2)*B_i; U_i=xi_i+eta_i; V_i=(xi_i-eta_i)/sqrt(2); W_i=xi_i*eta_i.",
